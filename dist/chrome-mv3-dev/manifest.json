{
  "manifest_version": 3,
  "name": "Subscribed Since",
  "description": "Displays YouTube channel subscription dates",
  "version": "1.0.0",
  "short_name": "Subscribed Since",
  "icons": {
    "128": "icon/128.png"
  },
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://www.googleapis.com/*",
    "http://localhost/*"
  ],
  "oauth2": {
    "client_id": "1082059658861-8kmr863dfip3968o8d79k92tner2h910.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/youtube.readonly"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-context-channel.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "commands": {
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Subscribed Since",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://localhost:3000; object-src 'self';",
    "sandbox": "script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000; sandbox allow-scripts allow-forms allow-popups allow-modals; child-src 'self';"
  }
}